---
const services = [
  { href: "/leckortung/", title: "Leckortung", text: "Präzise Ortung selbst kleinster Leckagen – zerstörungsarm, schnell und zuverlässig." },
  { href: "/bautrocknung/", title: "Bautrocknung", text: "Effiziente technische Trocknung zur schnellen und nachhaltigen Beseitigung von Feuchtigkeit." },
  { href: "/wiederherstellung/", title: "Wiederherstellung", text: "Fachgerechte Wiederherstellung beschädigter Bereiche – sauber, vollständig und aus einer Hand." },
];
---
<div class="grid-3">
  {services.map((s) => (
    <a href={s.href} class="card service-card">
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </a>
  ))}
</div>

<style>
  .service-card {
    text-decoration: none;
    color: inherit;
    display: block;
    border-top: 3px solid var(--color-accent);
  }
  .service-card:hover { border-top-color: var(--color-primary); }
  .service-card h3 { margin-top: 0; }
  .service-card p { color: var(--color-ink-soft); margin-bottom: 0; font-size: .95rem; }
</style>
