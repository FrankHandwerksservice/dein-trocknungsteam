---
import { getEntry } from 'astro:content';
import ServiceLayout from '../layouts/ServiceLayout.astro';

const entry = await getEntry('services', 'bautrocknung');
const { Content: Body } = await entry.render();
---
<ServiceLayout title={entry.data.title} heroSubtitle={entry.data.heroSubtitle} metaDescription={entry.data.metaDescription}>
  <Body />
</ServiceLayout>
