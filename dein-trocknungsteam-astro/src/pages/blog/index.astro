---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="Ratgeber Trocknung & Wasserschaden | Dein Trocknungsteam"
  description="Erfahren Sie alles über professionelle Trocknung, Leckortung und Sanierung. Experten-Tipps für Hausbesitzer und Bauherren in unserem Blog."
>
  <section class="section">
    <div class="container">
      <h1>Ratgeber & News rund um die Trocknung und Sanierung</h1>
      <p class="prose">In unserem Magazin finden Sie Experten-Tipps zur Trocknung, Leckortung und Schimmelvermeidung.</p>
      <div class="grid-3 post-grid">
        {posts.map((post) => (
          <a href={`/${post.slug}/`} class="card post-card">
            <h3>{post.data.title}</h3>
            <p>{post.data.metaDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <style>
    .post-grid { margin-top: 2rem; }
    .post-card { text-decoration: none; color: inherit; border-top: 3px solid var(--color-accent); }
    .post-card p { color: var(--color-ink-soft); font-size: .92rem; }
  </style>
</BaseLayout>
