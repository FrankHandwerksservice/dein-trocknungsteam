---
const badges = [
  { src: "/images/partner/rv-versicherung.webp", alt: "R+V Versicherung" },
  { src: "/images/partner/rheinland-versicherung.webp", alt: "RheinLand Versicherung" },
  { src: "/images/partner/allianz-versicherung.webp", alt: "Allianz Versicherung" },
  { src: "/images/partner/ergo-versicherung.webp", alt: "ERGO Versicherung" },
  { src: "/images/partner/lvm-versicherung.webp", alt: "LVM Versicherung" },
  { src: "/images/partner/axa-versicherung.webp", alt: "AXA Versicherung" },
  { src: "/images/partner/barmenia-gothaer-versicherung.webp", alt: "Barmenia Gothaer Versicherung" },
  { src: "/images/partner/continentale-versicherung.webp", alt: "Die Continentale Versicherung" },
];
const loopBadges = [...badges, ...badges];
---
<div class="badges-marquee" role="img" aria-label="Versicherungspartner: R+V, RheinLand, Allianz, ERGO, LVM, AXA, Barmenia Gothaer, Die Continentale">
  <div class="badges-track">
    {loopBadges.map((b) => <img src={b.src} alt="" loading="lazy" />)}
  </div>
</div>

<style>
.badges-marquee {
  overflow: hidden;
  margin: 2rem 0;
  -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
}
.badges-track {
  display: flex;
  align-items: center;
  gap: 2.5rem;
  width: max-content;
  animation: badges-scroll 22s linear infinite;
}
.badges-track img {
  height: 34px;
  width: auto;
  object-fit: contain;
  opacity: .55;
  filter: grayscale(1);
  flex-shrink: 0;
  transition: opacity .2s ease, filter .2s ease;
}
.badges-track img:hover { opacity: .9; filter: grayscale(0); }
@keyframes badges-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .badges-track { animation: none; overflow-x: auto; }
}
</style>
