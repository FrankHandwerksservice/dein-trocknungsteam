---
const { faq } = Astro.props;
---
<div class="faq">
  {faq.map((item: { q: string; a: string }) => (
    <details class="faq-item">
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-primary-dark);
  }
  .faq-item p { margin: .75rem 0 0; color: var(--color-ink-soft); }
</style>
