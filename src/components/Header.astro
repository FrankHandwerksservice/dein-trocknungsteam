<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <img src="https://dein-trocknungsteam.de/wp-content/uploads/2026/05/imgi_1_md2x-1-e1777972942533.webp" alt="Dein Trocknungsteam Logo" height="40" />
    </a>
    <nav class="main-nav">
      <a href="/bautrocknung/">Bautrocknung</a>
      <a href="/leckortung/">Leckortung</a>
      <a href="/wiederherstellung/">Wiederherstellung</a>
