<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    gap: 1.5rem;
  }
  .logo {
    display: flex;
    align-items: center;
  }
  .main-nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .main-nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: .95rem;
  }
  .main-nav a:hover { color: var(--color-primary); }
  .header-cta { white-space: nowrap; font-size: .9rem; padding: .6rem 1.1rem; }

  @media (max-width: 720px) {
    .main-nav { display: none; }
  }
</style>
