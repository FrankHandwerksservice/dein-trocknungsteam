---
const services = [
  { href: "/leckortung/", title: "Leckortung", text: "Präzise Ortung selbst kleinster Leckagen – zerstörungsarm, schnell und zuverlässig.", icon: "https://dein-trocknungsteam.de/wp-content/uploads/2026/05/image-6.webp" },
  { href: "/bautrocknung/", title: "Bautrocknung", text: "Effiziente technische Trocknung zur schnellen und nachhaltigen Beseitigung von Feuchtigkeit.", icon: "https://dein-trocknungsteam.de/wp-content/uploads/2026/05/image-4.webp" },
  { href: "/wiederherstellung/", title: "Wiederherstellung", text: "Fachgerechte Wiederherstellung beschädigter Bereiche – sauber, vollständig und aus einer Hand.", icon: "https://dein-trocknungsteam.de/wp-content/uploads/2026/05/image-5.webp" },
];
---
<div class="grid-3">
  {services.map((s) => (
    <a href={s.href} class="card service-card">
      <img src={s.icon} alt="" class="service-icon" loading="lazy" />
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </a>
  ))}
</div>

<style>
  .service-card {
    text-decoration: none;
    color: inherit;
    display: block;
    border-top: 3px solid var(--color-accent);
  }
  .service-card:hover { border-top-color: var(--color-primary); }
  .service-icon { width: 48px; height: 48px; object-fit: contain; margin-bottom: .75rem; }
  .service-card h3 { margin-top: 0; }
  .service-card p { color: var(--color-ink-soft); margin-bottom: 0; font-size: .95rem; }
</style>
