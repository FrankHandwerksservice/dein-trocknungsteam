---
// Verlinkte Chip-Liste zu allen Einsatzgebiet-Seiten (Städte), für interne
// Verlinkung von Kernseiten (Leckortung, Bautrocknung) zu den lokalen Landingpages.
const { cities } = Astro.props;
---
<div class="chip-list">
  {cities.map((c: { name: string; slug: string }) => (
    <a class="chip" href={`/${c.slug}/`}>{c.name}</a>
  ))}
</div>

<style>
  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin-top: 1.5rem;
  }
  .chip {
    display: inline-block;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: .5rem 1.1rem;
    font-size: .9rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
