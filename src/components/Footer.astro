<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">Dein Trocknungsteam</p>
      <p class="footer-tag">Seit Jahren finden wir (fast) jede Leckage und führen Bautrocknungen durch.</p>
    </div>
    <div>
      <h3>Unternehmen</h3>
      <a href="/#uber">Über uns</a>
      <a href="/#leistungen">Leistungen</a>
      <a href="/blog/">Blog</a>
    </div>
    <div>
      <h3>Leistungen</h3>
      <a href="/bautrocknung/">Bautrocknung</a>
      <a href="/leckortung/">Leckortung</a>
      <a href="/wiederherstellung/">Sanierung</a>
    </div>
    <div>
      <h3>Rechtliches</h3>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Dein Trocknungsteam ist eine Marke der Frank Handwerksservice GmbH</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: #D8E2E4;
    margin-top: 4rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
    padding: 3rem 1.5rem 2rem;
  }
  .footer-grid a {
    display: block;
    color: #B7C6C9;
    text-decoration: none;
    margin-bottom: .5rem;
    font-size: .92rem;
  }
  .footer-grid a:hover { color: white; }
  .footer-grid h3 {
    color: white;
    font-family: var(--font-body);
    font-size: .85rem;
    text-transform: none;
    margin: 0 0 .8rem;
  }
  .footer-brand {
    font-family: var(--font-display);
    color: white;
    font-size: 1.1rem;
    margin: 0 0 .5rem;
  }
  .footer-tag { color: #A9BABD; font-size: .9rem; max-width: 32ch; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,.12);
    padding: 1.2rem 1.5rem;
    font-size: .82rem;
    color: #90A3A6;
  }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
