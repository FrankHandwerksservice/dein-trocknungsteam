---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  geoLat?: number;
  geoLng?: number;
  geoPlacename?: string;
  jsonLd?: string;
  ogImage?: string;
}
const { title, description, geoLat, geoLng, geoPlacename, jsonLd, ogImage } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:image" content={new URL(ogImage || '/images/site/logo.webp', Astro.site).toString()} />
    <meta property="og:locale" content="de_DE" />
    {geoLat !== undefined && geoLng !== undefined && (
      <>
        <meta name="geo.region" content="DE-NW" />
        {geoPlacename && <meta name="geo.placename" content={geoPlacename} />}
        <meta name="geo.position" content={`${geoLat};${geoLng}`} />
        <meta name="ICBM" content={`${geoLat}, ${geoLng}`} />
      </>
    )}
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="preload" as="style" href="https://use.typekit.net/yez0rtj.css" />
    <link rel="stylesheet" href="https://use.typekit.net/yez0rtj.css" media="print" onload="this.media='all'; this.onload=null;" />
    <noscript><link rel="stylesheet" href="https://use.typekit.net/yez0rtj.css" /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["HomeAndConstructionBusiness", "LocalBusiness"],
          "@id": "https://dein-trocknungsteam.de/#business",
          "name": "Dein Trocknungsteam",
          "legalName": "Frank Handwerksservice GmbH",
          "url": "https://dein-trocknungsteam.de/",
          "logo": "https://dein-trocknungsteam.de/images/site/logo.webp",
          "image": "https://dein-trocknungsteam.de/images/site/logo.webp",
          "description": "Leckortung, Bautrocknung und Wasserschadensanierung in Neuss und Umgebung.",
          "telephone": "+4915785119191",
          "email": "info@frank-handwerksservice.de",
          "founder": { "@type": "Person", "name": "Philipp Frank" },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Am Alten Bach 93b",
            "postalCode": "41470",
            "addressLocality": "Neuss",
            "addressRegion": "NRW",
            "addressCountry": "DE"
          },
          "areaServed": [
            {"@type": "City", "name": "Neuss"},
            {"@type": "City", "name": "Düsseldorf"},
            {"@type": "City", "name": "Grevenbroich"},
            {"@type": "City", "name": "Krefeld"},
            {"@type": "City", "name": "Mönchengladbach"}
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Leistungen",
            "itemListElement": [
              {"@type": "Offer", "itemOffered": {"@id": "https://dein-trocknungsteam.de/leckortung/#service"}},
              {"@type": "Offer", "itemOffered": {"@id": "https://dein-trocknungsteam.de/bautrocknung/#service"}},
              {"@type": "Offer", "itemOffered": {"@id": "https://dein-trocknungsteam.de/wiederherstellung/#service"}}
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://dein-trocknungsteam.de/#website",
          "url": "https://dein-trocknungsteam.de/",
          "name": "Dein Trocknungsteam",
          "inLanguage": "de-DE",
          "publisher": {"@id": "https://dein-trocknungsteam.de/#business"}
        }
      ]
    })} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
