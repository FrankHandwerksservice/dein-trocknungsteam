---
import BaseLayout from './BaseLayout.astro';
import CallButton from '../components/CallButton.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import DistrictGrid from '../components/DistrictGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const {
  name,
  metaTitle,
  metaDescription,
  heroText,
  introParagraphs,
  introImage,
  districtIntro,
  districtImage,
  districts,
  faq,
  geoLat,
  geoLng,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": homeUrl },
    { "@type": "ListItem", "position": 2, "name": name, "item": pageUrl },
  ],
});
---
<BaseLayout title={metaTitle} description={metaDescription} geoLat={geoLat} geoLng={geoLng} geoPlacename={name} jsonLd={breadcrumbJsonLd}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Startseite</a> <span class="sep" aria-hidden="true">›</span> <span aria-current="page">{name}</span>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <p class="eyebrow">Zertifizierter Fachbetrieb</p>
      <h1>Bautrocknung & Leckortung in {name}</h1>
      <p class="hero-subtitle">{heroText}</p>
      <CallButton />
    </div>
  </section>

  {introParagraphs && introParagraphs.length > 0 && (
    <section class="section">
      <div class={`container content-grid ${introImage ? '' : 'single'}`}>
        <div class="prose">
          {introParagraphs.map((p) => <p>{p}</p>)}
        </div>
        {introImage && (
          <div class="content-photo">
            <img src={introImage} alt={`Bautrocknung in ${name}`} loading="lazy" />
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section section-alt">
    <div class={`container content-grid reverse ${districtImage ? '' : 'single'}`}>
      {districtImage && (
        <div class="content-photo">
          <img src={districtImage} alt={`Stadtteile in ${name}`} loading="lazy" />
        </div>
      )}
      <div class="prose">
        <h2>Vor Ort in Ihrer Nähe: Stadtteile in {name}</h2>
        <p>{districtIntro || `Wir sind täglich für unsere Kunden in ganz ${name} im Einsatz.`}</p>
        <DistrictGrid districts={districts} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Unsere Leistungen</h2>
      <ServicesGrid />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Häufig gestellte Fragen zu Schäden in {name}</h2>
      <FaqAccordion faq={faq} />
    </div>
  </section>

  <style>
    .breadcrumb {
      padding: .85rem 0;
      font-size: .85rem;
      color: var(--color-ink-soft);
      border-bottom: 1px solid var(--color-border);
    }
    .breadcrumb a {
      color: var(--color-ink-soft);
      text-decoration: none;
    }
    .breadcrumb a:hover { color: var(--color-accent); }
    .breadcrumb .sep { margin: 0 .4rem; }
    .breadcrumb [aria-current="page"] { color: var(--color-ink); font-weight: 600; }
    .hero {
      padding: 3.5rem 0 2.5rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .eyebrow {
      color: var(--color-accent);
      font-weight: 600;
      font-size: .9rem;
      margin: 0 0 .5rem;
    }
    .hero-subtitle {
      color: var(--color-ink-soft);
      font-size: 1.1rem;
      max-width: 65ch;
      margin-bottom: 1.5rem;
    }
    .content-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
      align-items: start;
    }
    .content-grid.single {
      grid-template-columns: 1fr;
    }
    .content-grid.single .prose {
      max-width: var(--measure);
    }
    .content-grid.reverse {
      grid-template-columns: 1fr 1.1fr;
    }
    .content-photo {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      min-height: 420px;
    }
    .content-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      inset: 0;
    }
    @media (max-width: 800px) {
      .content-grid { grid-template-columns: 1fr; }
      .content-grid.reverse { grid-template-columns: 1fr; }
      .content-photo { min-height: 280px; }
      .content-grid.reverse .prose { order: 1; }
      .content-grid.reverse .content-photo { order: 2; }
    }
  </style>
</BaseLayout>
