---
import BaseLayout from './BaseLayout.astro';
import CallButton from '../components/CallButton.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import DistrictGrid from '../components/DistrictGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const { name, metaTitle, metaDescription, heroText, introParagraphs, districtIntro, districts, faq } = Astro.props;
---
<BaseLayout title={metaTitle} description={metaDescription}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Zertifizierter Fachbetrieb</p>
      <h1>Bautrocknung & Leckortung in {name}</h1>
      <p class="hero-subtitle">{heroText}</p>
      <CallButton />
    </div>
  </section>

  {introParagraphs && introParagraphs.length > 0 && (
    <section class="section">
      <div class="container prose">
        {introParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Unsere Leistungen</h2>
      <ServicesGrid />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Vor Ort in Ihrer Nähe: Stadtteile in {name}</h2>
      <p class="prose">{districtIntro || `Wir sind täglich für unsere Kunden in ganz ${name} im Einsatz.`}</p>
      <DistrictGrid districts={districts} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Häufig gestellte Fragen zu Schäden in {name}</h2>
      <FaqAccordion faq={faq} />
    </div>
  </section>

  <style>
    .hero {
      padding: 3.5rem 0 2.5rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .eyebrow {
      color: var(--color-accent);
      font-weight: 600;
      font-size: .9rem;
      margin: 0 0 .5rem;
    }
    .hero-subtitle {
      color: var(--color-ink-soft);
      font-size: 1.1rem;
      max-width: 55ch;
      margin-bottom: 1.5rem;
    }
  </style>
</BaseLayout>
