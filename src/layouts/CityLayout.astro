---
import BaseLayout from './BaseLayout.astro';
import CallButton from '../components/CallButton.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import DistrictGrid from '../components/DistrictGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const {
  name,
  metaTitle,
  metaDescription,
  heroText,
  introParagraphs,
  districtIntro,
  districts,
  faq,
  distanceKm,
  distanceMinutes,
  geoLat,
  geoLng,
  processSteps,
  neighborCities,
  caseExampleTitle,
  caseExampleText,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": homeUrl },
    { "@type": "ListItem", "position": 2, "name": name, "item": pageUrl },
  ],
});
---
<BaseLayout title={metaTitle} description={metaDescription} geoLat={geoLat} geoLng={geoLng} geoPlacename={name} jsonLd={breadcrumbJsonLd}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Startseite</a> <span class="sep" aria-hidden="true">›</span> <span aria-current="page">{name}</span>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <p class="eyebrow">Zertifizierter Fachbetrieb</p>
      <h1>Bautrocknung & Leckortung in {name}</h1>
      <p class="hero-subtitle">{heroText}</p>
      {distanceKm !== undefined && (
        <p class="distance-badge">📍 Nur ca. {distanceKm} km von unserem Standort entfernt{distanceMinutes !== undefined ? ` – ca. ${distanceMinutes} Minuten Anfahrt` : ''}</p>
      )}
      <CallButton />
    </div>
  </section>

  {introParagraphs && introParagraphs.length > 0 && (
    <section class="section">
      <div class="container prose">
        {introParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Unsere Leistungen</h2>
      <ServicesGrid />
    </div>
  </section>

  {processSteps && processSteps.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <p class="eyebrow">Wie geht es weiter?</p>
        <h2>So läuft ein Einsatz in {name} ab</h2>
        <ol class="steps">
          {processSteps.map((s) => (
            <li>
              <span class="step-num"></span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {caseExampleText && caseExampleText.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>{caseExampleTitle || `Ein typischer Einsatz in ${name}`}</h2>
        <p class="case-note">Beispielhafter Ablauf aus unserer Praxis</p>
        <div class="prose">
          {caseExampleText.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  <section class="section section-alt">
    <div class="container">
      <h2>Vor Ort in Ihrer Nähe: Stadtteile in {name}</h2>
      <p class="prose">{districtIntro || `Wir sind täglich für unsere Kunden in ganz ${name} im Einsatz.`}</p>
      <DistrictGrid districts={districts} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Häufig gestellte Fragen zu Schäden in {name}</h2>
      <FaqAccordion faq={faq} />
    </div>
  </section>

  {neighborCities && neighborCities.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2>Auch in Ihrer Nähe im Einsatz</h2>
        <p class="prose">Wir sind nicht nur in {name} für Sie da, sondern auch in den umliegenden Städten:</p>
        <ul class="neighbor-list">
          {neighborCities.map((c) => (
            <li><a href={`/${c.slug}`}>Leckortung & Bautrocknung in {c.name}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <style>
    .breadcrumb {
      padding: .85rem 0;
      font-size: .85rem;
      color: var(--color-ink-soft);
      border-bottom: 1px solid var(--color-border);
    }
    .breadcrumb a {
      color: var(--color-ink-soft);
      text-decoration: none;
    }
    .breadcrumb a:hover { color: var(--color-accent); }
    .breadcrumb .sep { margin: 0 .4rem; }
    .breadcrumb [aria-current="page"] { color: var(--color-ink); font-weight: 600; }
    .hero {
      padding: 3.5rem 0 2.5rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .eyebrow {
      color: var(--color-accent);
      font-weight: 600;
      font-size: .9rem;
      margin: 0 0 .5rem;
    }
    .hero-subtitle {
      color: var(--color-ink-soft);
      font-size: 1.1rem;
      max-width: 55ch;
      margin-bottom: 1rem;
    }
    .distance-badge {
      display: inline-block;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 999px;
      padding: .5rem 1rem;
      font-size: .9rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }
    .steps {
      list-style: none;
      padding: 0;
      margin: 2rem 0 0;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      counter-reset: step;
    }
    .steps li {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      counter-increment: step;
    }
    .step-num {
      flex-shrink: 0;
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background: var(--color-accent);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: .9rem;
    }
    .step-num::before { content: counter(step); }
    .steps li h3 { margin: 0 0 .3rem; }
    .steps li p { margin: 0; color: var(--color-ink-soft); }
    .case-note {
      color: var(--color-ink-soft);
      font-size: .85rem;
      font-style: italic;
      margin-top: -.5rem;
    }
    .neighbor-list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .neighbor-list a {
      display: block;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 1rem 1.25rem;
      color: var(--color-ink);
      text-decoration: none;
      font-weight: 600;
    }
    .neighbor-list a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  </style>
</BaseLayout>
