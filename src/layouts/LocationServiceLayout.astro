---
import BaseLayout from './BaseLayout.astro';
import CallButton from '../components/CallButton.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const {
  title,
  metaDescription,
  breadcrumbLabel,
  heroEyebrow = 'Fachbetrieb vor Ort',
  heroTitle,
  heroSubtitle,
  serviceType,
  cityName,
  faq,
  relatedLinks,
  geoLat,
  geoLng,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();
const businessId = `${homeUrl}#business`;

const jsonLdBlocks: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": homeUrl },
      { "@type": "ListItem", "position": 2, "name": breadcrumbLabel, "item": pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    "name": title,
    "serviceType": serviceType,
    "url": pageUrl,
    "description": metaDescription,
    "areaServed": { "@type": "City", "name": cityName },
    "provider": { "@id": businessId },
  },
];

if (faq && faq.length > 0) {
  jsonLdBlocks.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((item: { q: string; a: string }) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a },
    })),
  });
}

const combinedJsonLd = JSON.stringify(jsonLdBlocks);
---
<BaseLayout title={title} description={metaDescription} geoLat={geoLat} geoLng={geoLng} geoPlacename={cityName} jsonLd={combinedJsonLd}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Startseite</a> <span class="sep" aria-hidden="true">›</span> <span aria-current="page">{breadcrumbLabel}</span>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <p class="eyebrow">{heroEyebrow}</p>
      <h1>{heroTitle}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <CallButton />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>

  {faq && faq.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2>Häufig gestellte Fragen</h2>
        <FaqAccordion faq={faq} />
      </div>
    </section>
  )}

  {relatedLinks && relatedLinks.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Weiterführend</h2>
        <ul class="related-links">
          {relatedLinks.map((l: { href: string; label: string }) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <style>
    .breadcrumb {
      padding: .85rem 0;
      font-size: .85rem;
      color: var(--color-ink-soft);
      border-bottom: 1px solid var(--color-border);
    }
    .breadcrumb a { color: var(--color-ink-soft); text-decoration: none; }
    .breadcrumb a:hover { color: var(--color-accent-dark); }
    .breadcrumb .sep { margin: 0 .4rem; }
    .breadcrumb [aria-current="page"] { color: var(--color-ink); font-weight: 600; }
    .hero {
      padding: 3.5rem 0 2.5rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .eyebrow { color: var(--color-accent-dark); font-weight: 600; font-size: .9rem; margin: 0 0 .5rem; }
    .hero-subtitle { color: var(--color-ink-soft); font-size: 1.1rem; max-width: 75ch; margin-bottom: 1.5rem; }
    .prose { max-width: var(--measure); }
    .related-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
    .related-links a { color: var(--color-accent-dark); font-weight: 600; text-decoration: none; }
    .related-links a:hover { text-decoration: underline; }
  </style>
</BaseLayout>
