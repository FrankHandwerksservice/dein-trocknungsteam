---
import BaseLayout from './BaseLayout.astro';
import CallButton from '../components/CallButton.astro';

const { title, metaDescription, pubDate, heroImage } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${title} | Dein Trocknungsteam`} description={metaDescription}>
<article class="section">
<div class="container prose">
{heroImage && <img src={heroImage} alt={title} title={title} class="post-hero-image" />}
<p class="post-date">{formattedDate}</p>
<slot />
<div class="post-cta">
<p>Haben Sie aktuell einen Wasserschaden?</p>
<CallButton label="Jetzt Hilfe anfordern" />
</div>
</div>
</article>

<style>
.post-hero-image {
width: 100%;
max-height: 420px;
object-fit: cover;
border-radius: var(--radius);
margin-bottom: 1.5rem;
display: block;
}
.post-date {
color: var(--color-ink-soft);
font-size: .9rem;
text-transform: none;
}
.post-cta {
margin-top: 3rem;
padding: 1.5rem;
background: var(--color-surface);
border: 1px solid var(--color-border);
border-radius: var(--radius);
}
.post-cta p { margin-top: 0; font-weight: 600; }
</style>
</BaseLayout>
