---
import BaseLayout from './BaseLayout.astro';
import CallButton from '../components/CallButton.astro';

const {
  title, metaDescription, pubDate, dateModified, heroImage, slug,
  serviceHref, serviceLabel, author = "Philipp Frank", authorBio, sources,
} = Astro.props;
const formattedDate = pubDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
const effectiveModified = dateModified ?? pubDate;
const formattedModified = effectiveModified.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });

const homeUrl = new URL('/', Astro.site).toString();
const blogUrl = new URL('/blog/', Astro.site).toString();
const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const isoDate = pubDate.toISOString().slice(0, 10);
const isoModified = effectiveModified.toISOString().slice(0, 10);

const jsonLdBlocks = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": homeUrl },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": blogUrl },
      { "@type": "ListItem", "position": 3, "name": title, "item": postUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": postUrl,
    "headline": title,
    "description": metaDescription,
    "datePublished": isoDate,
    "dateModified": isoModified,
    "author": { "@type": "Person", "name": author },
    "publisher": { "@id": `${homeUrl}#business` },
    ...(heroImage ? { "image": new URL(heroImage, Astro.site).toString() } : {}),
    "inLanguage": "de-DE",
  },
];
const combinedJsonLd = JSON.stringify(jsonLdBlocks);
---
<BaseLayout title={`${title} | Dein Trocknungsteam`} description={metaDescription} jsonLd={combinedJsonLd} ogImage={heroImage}>
<article class="section">
<div class="container prose">
{heroImage && <img src={heroImage} alt={title} title={title} class="post-hero-image" />}
<p class="post-date">Veröffentlicht am {formattedDate}{dateModified && formattedModified !== formattedDate && <> · Aktualisiert am {formattedModified}</>}</p>
<slot />
{sources && sources.length > 0 && (
  <div class="post-sources">
    <h2>Quellen</h2>
    <ul>
      {sources.map((s: { label: string; url: string }) => (
        <li><a href={s.url} target="_blank" rel="noopener noreferrer nofollow">{s.label}</a></li>
      ))}
    </ul>
  </div>
)}
{serviceHref && (
  <p class="post-related-link">
    Mehr zum Thema: <a href={serviceHref}>{serviceLabel}</a> · Wir sind auch in <a href="/neuss/">Neuss</a> für Sie im Einsatz.
  </p>
)}
<div class="post-author-box">
  <p class="post-author-name">{author}</p>
  {authorBio && <p class="post-author-bio">{authorBio}</p>}
</div>
<div class="post-cta">
<p>Haben Sie aktuell einen Wasserschaden?</p>
<CallButton label="Jetzt Hilfe anfordern" />
</div>
</div>
</article>

<style>
.post-hero-image {
width: 100%;
max-height: 420px;
object-fit: cover;
border-radius: var(--radius);
margin-bottom: 1.5rem;
display: block;
}
.post-date {
color: var(--color-ink-soft);
font-size: .9rem;
text-transform: none;
}
.post-cta {
margin-top: 3rem;
padding: 1.5rem;
background: var(--color-surface);
border: 1px solid var(--color-border);
border-radius: var(--radius);
}
.post-cta p { margin-top: 0; font-weight: 600; }
.post-related-link {
margin-top: 2.5rem;
padding-top: 1.5rem;
border-top: 1px solid var(--color-border);
color: var(--color-ink-soft);
font-size: .95rem;
}
.post-related-link a { color: var(--color-accent); font-weight: 600; }
.post-sources {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--color-border);
}
.post-sources h2 { font-size: 1.05rem; margin-bottom: .75rem; }
.post-sources ul { margin: 0; padding-left: 1.2rem; font-size: .9rem; color: var(--color-ink-soft); }
.post-sources a { color: var(--color-accent-dark); }
.post-author-box {
  margin-top: 2rem;
  padding: 1.25rem 1.5rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
}
.post-author-name { margin: 0; font-weight: 700; }
.post-author-bio { margin: .35rem 0 0; color: var(--color-ink-soft); font-size: .92rem; }
</style>
</BaseLayout>
