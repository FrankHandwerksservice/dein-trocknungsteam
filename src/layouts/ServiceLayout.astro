---
import BaseLayout from './BaseLayout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CallButton from '../components/CallButton.astro';

const { title, heroSubtitle, metaDescription } = Astro.props;
---
<BaseLayout title={`${title} | Dein Trocknungsteam`} description={metaDescription}>
  <section class="hero">
    <div class="container">
      <h1>{title}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <CallButton />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <slot />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Unsere Leistungen</h2>
      <ServicesGrid />
    </div>
  </section>

  <style>
    .hero {
      padding: 3.5rem 0 2.5rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .hero-subtitle {
      color: var(--color-ink-soft);
      font-size: 1.1rem;
      max-width: 50ch;
      margin-bottom: 1.5rem;
    }
  </style>
</BaseLayout>
