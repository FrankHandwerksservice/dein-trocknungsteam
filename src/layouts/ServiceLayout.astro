---
import BaseLayout from './BaseLayout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CallButton from '../components/CallButton.astro';

const { title, heroSubtitle, metaDescription, heroImage } = Astro.props;
---
<BaseLayout title={`${title} | Dein Trocknungsteam`} description={metaDescription}>
  <section class="hero">
    <div class="container">
      <h1>{title}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <CallButton />
    </div>
  </section>

  <section class="section">
    <div class={`container content-grid ${heroImage ? '' : 'single'}`}>
      <div class="prose">
        <slot />
      </div>
      {heroImage && (
        <div class="content-photo">
          <img src={heroImage} alt={title} loading="lazy" />
        </div>
      )}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Unsere Leistungen</h2>
      <ServicesGrid />
    </div>
  </section>

  <style>
    .hero {
      padding: 3.5rem 0 2.5rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .hero-subtitle {
      color: var(--color-ink-soft);
      font-size: 1.1rem;
      max-width: 50ch;
      margin-bottom: 1.5rem;
    }
    .content-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
      align-items: start;
    }
    .content-grid.single {
      grid-template-columns: 1fr;
    }
    .content-grid.single .prose {
      max-width: var(--measure);
    }
    .content-photo {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      min-height: 420px;
    }
    .content-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      inset: 0;
    }
    @media (max-width: 800px) {
      .content-grid { grid-template-columns: 1fr; }
      .content-photo { min-height: 280px; }
    }
  </style>
</BaseLayout>
