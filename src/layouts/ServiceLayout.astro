---
import BaseLayout from './BaseLayout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CallButton from '../components/CallButton.astro';
import CityLinkGrid from '../components/CityLinkGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const { title, heroSubtitle, metaDescription, heroImage, techniquesHeading, techniquesImage, techniques, cities, citiesHeading, citiesIntro, faq } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();

const jsonLdBlocks = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": homeUrl },
      { "@type": "ListItem", "position": 2, "name": title, "item": pageUrl },
    ],
  },
];

if (cities && cities.length > 0) {
  jsonLdBlocks.push({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": title,
    "description": metaDescription,
    "areaServed": cities.map((c: { name: string }) => ({ "@type": "City", "name": c.name })),
    "provider": {
      "@type": "LocalBusiness",
      "name": "Dein Trocknungsteam",
      "url": homeUrl,
    },
  });
}

if (faq && faq.length > 0) {
  jsonLdBlocks.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((item: { q: string; a: string }) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a },
    })),
  });
}

const combinedJsonLd = JSON.stringify(jsonLdBlocks);
---
<BaseLayout title={`${title} | Dein Trocknungsteam`} description={metaDescription} jsonLd={combinedJsonLd}>
  <section class="hero">
    <div class="container">
      <h1>{title}</h1>
      <p class="hero-subtitle">{heroSubtitle}</p>
      <CallButton />
    </div>
  </section>

  <section class="section">
    <div class={`container content-grid ${heroImage ? '' : 'single'}`}>
      <div class="prose">
        <slot />
      </div>
      {heroImage && (
        <div class="content-photo">
          <img src={heroImage} alt={title} title={title} loading="lazy" />
        </div>
      )}
    </div>
  </section>

  {techniques && techniques.length > 0 && (
    <section class="section section-alt">
      <div class="container content-grid reverse">
        {techniquesImage && (
          <div class="content-photo">
            <img src={techniquesImage} alt={techniquesHeading} title={techniquesHeading} loading="lazy" />
          </div>
        )}
        <div class="prose">
          <h2>{techniquesHeading}</h2>
          {techniques.map((t) => (
            <p><strong>{t.label}</strong> — {t.text}</p>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Unsere Leistungen</h2>
      <ServicesGrid />
    </div>
  </section>

  {cities && cities.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2>{citiesHeading || `${title} in Ihrer Region`}</h2>
        <p class="cities-intro">{citiesIntro}</p>
        <CityLinkGrid cities={cities} />
      </div>
    </section>
  )}

  {faq && faq.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Häufig gestellte Fragen</h2>
        <FaqAccordion faq={faq} />
      </div>
    </section>
  )}

  <style>
    .hero {
      padding: 3.5rem 0 2.5rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .hero-subtitle {
      color: var(--color-ink-soft);
      font-size: 1.1rem;
      max-width: 85ch;
      margin-bottom: 1.5rem;
    }
    .content-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
      align-items: start;
    }
    .content-grid.single {
      grid-template-columns: 1fr;
    }
    .content-grid.single .prose {
      max-width: var(--measure);
    }
    .content-grid.reverse {
      grid-template-columns: 1fr 1.1fr;
    }
    .content-photo {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      min-height: 420px;
    }
    .content-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      inset: 0;
    }
    .cities-intro {
      color: var(--color-ink-soft);
      max-width: 75ch;
    }
    @media (max-width: 800px) {
      .content-grid { grid-template-columns: 1fr; }
      .content-grid.reverse { grid-template-columns: 1fr; }
      .content-photo { min-height: 280px; }
      .content-grid.reverse .prose { order: 1; }
      .content-grid.reverse .content-photo { order: 2; }
    }
  </style>
</BaseLayout>
