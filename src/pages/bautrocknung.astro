---
import { getEntry, getCollection } from 'astro:content';
import ServiceLayout from '../layouts/ServiceLayout.astro';

const entry = await getEntry('services', 'bautrocknung');
const { Content: Body } = await entry.render();

const cityEntries = await getCollection('cities');
const cities = cityEntries
  .map((c) => ({ name: c.data.name, slug: c.slug }))
  .sort((a, b) => a.name.localeCompare(b.name, 'de'));

const relatedPosts = [
  { slug: "effiziente-bautrocknung-warum-der-einfache-ventilator-nicht-ausreicht", title: "Warum ein Ventilator nicht ausreicht", excerpt: "Nach Rohrbruch oder Hochwasser reicht Lüften allein nicht aus – warum professionelle Bautrocknungsgeräte nötig sind." },
  { slug: "wer-zahlt-die-bautrocknung-nach-einem-wasserschaden", title: "Wer zahlt die Bautrocknung?", excerpt: "Gebäude- oder Hausratversicherung? Wer nach einem Wasserschaden für die Bautrocknung aufkommt." },
  { slug: "wasserschaden-unter-dem-estrich", title: "Wasserschaden unter dem Estrich", excerpt: "So erkennen Sie einen Wasserschaden unter dem Estrich rechtzeitig – 7 Anzeichen." },
];
---
<ServiceLayout
  title={entry.data.title}
  heroSubtitle={entry.data.heroSubtitle}
  metaDescription={entry.data.metaDescription}
  heroImage={entry.data.heroImage}
  techniquesHeading={entry.data.techniquesHeading}
  techniquesImage={entry.data.techniquesImage}
  techniques={entry.data.techniques}
  cities={cities}
  relatedPosts={relatedPosts}
  serviceType="Bautrocknung"
  citiesHeading="Bautrocknung in Ihrer Region"
  citiesIntro="Als Trocknungsfirma sind wir rund um Neuss und Grevenbroich ebenso im Einsatz wie im gesamten Rhein-Kreis Neuss, in Düsseldorf, Köln und den umliegenden Kreisen Mettmann und Heinsberg. Direkt zu Ihrer Stadt:"
  faq={entry.data.faq}
>
  <Body />
</ServiceLayout>
