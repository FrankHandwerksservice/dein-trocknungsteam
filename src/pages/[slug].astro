---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

export async function getStaticPaths() {
const posts = await getCollection('blog');
return posts.map((post) => ({
params: { slug: post.slug },
props: { post },
}));
}

const { post } = Astro.props;
const { Content } = await post.render();

const serviceMap: Record<string, { href: string; label: string }> = {
"leckortung-bei-wasserschaden-leckagen-schnell-finden": { href: "/leckortung/", label: "Leckortung" },
"leckortung-fussbodenheizung": { href: "/leckortung/", label: "Leckortung" },
"wasserschaden-unter-dem-estrich": { href: "/bautrocknung/", label: "Bautrocknung" },
"effiziente-bautrocknung-warum-der-einfache-ventilator-nicht-ausreicht": { href: "/bautrocknung/", label: "Bautrocknung" },
"wer-zahlt-die-bautrocknung-nach-einem-wasserschaden": { href: "/bautrocknung/", label: "Bautrocknung" },
"wasserschaden-sanierung-aus-einer-hand-vom-leck-bis-zum-neuen-anstrich": { href: "/wiederherstellung/", label: "Wasserschadensanierung" },
"wer-zahlt-die-sanierung-nach-einem-wasserschaden": { href: "/wiederherstellung/", label: "Wasserschadensanierung" },
"gebaeudeversicherung-bei-wasserschaden-wer-zahlt-was": { href: "/wiederherstellung/", label: "Wasserschadensanierung" },
};
const related = serviceMap[post.slug];
---
<BlogLayout title={post.data.title} metaDescription={post.data.metaDescription} pubDate={post.data.pubDate} heroImage={post.data.heroImage} slug={post.slug} serviceHref={related?.href} serviceLabel={related?.label}>
<Content />
</BlogLayout>
