---
import LocationServiceLayout from '../../layouts/LocationServiceLayout.astro';

const faq = [
  {
    q: "Wie schnell sind Sie bei einer Leckortung in Düsseldorf vor Ort?",
    a: "Von unserem Standort in Neuss aus sind wir in Düsseldorf in der Regel innerhalb von 20 bis 30 Minuten vor Ort, bei akuten Notfällen entsprechend zügig."
  },
  {
    q: "Arbeiten Sie in ganz Düsseldorf oder nur in bestimmten Stadtteilen?",
    a: "Wir sind im gesamten Düsseldorfer Stadtgebiet im Einsatz, von der Innenstadt bis in die umliegenden Stadtteile – auf Anfrage klären wir gerne, wie schnell wir konkret bei Ihnen sein können."
  },
  {
    q: "Wie funktioniert eine zerstörungsfreie Leckortung?",
    a: "Mit Verfahren wie Thermografie, akustischer Leckortung, Tracergas und Endoskopie lokalisieren wir die Schadstelle punktgenau, ohne Wände aufzustemmen oder Böden großflächig zu öffnen."
  },
  {
    q: "Wer zahlt die Leckortung bei einem Wasserschaden in Düsseldorf?",
    a: "Ist die Ursache ein versicherter Leitungswasserschaden, übernimmt in der Regel die Gebäudeversicherung die Kosten der Leckortung. Wir dokumentieren den Befund für eine unkomplizierte Abrechnung."
  },
];

const relatedLinks = [
  { href: "/leckortung/", label: "Mehr zur Leckortung: Techniken, Ablauf und Kosten" },
  { href: "/dusseldorf/", label: "Alle Leistungen in Düsseldorf auf einen Blick" },
  { href: "/bautrocknung/", label: "Nach der Ortung: professionelle Bautrocknung" },
