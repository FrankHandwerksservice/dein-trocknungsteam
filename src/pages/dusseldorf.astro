---
import { getEntry } from 'astro:content';
import CityLayout from '../layouts/CityLayout.astro';

const entry = await getEntry('cities', 'dusseldorf');
---
<CityLayout
  name={entry.data.name}
  metaTitle={entry.data.metaTitle}
  metaDescription={entry.data.metaDescription}
  heroText={entry.data.heroText}
  introParagraphs={entry.data.introParagraphs}
  districtIntro={entry.data.districtIntro}
  districts={entry.data.districts}
  faq={entry.data.faq}
  distanceKm={entry.data.distanceKm}
  distanceMinutes={entry.data.distanceMinutes}
  geoLat={entry.data.geoLat}
  geoLng={entry.data.geoLng}
  processSteps={entry.data.processSteps}
  neighborCities={entry.data.neighborCities}
  caseExampleTitle={entry.data.caseExampleTitle}
  caseExampleText={entry.data.caseExampleText}
/>
