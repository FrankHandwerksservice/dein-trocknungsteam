---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallButton from '../components/CallButton.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import TrustBadges from '../components/TrustBadges.astro';

const steps = [
  { title: "Anruf & Ersteinschätzung", text: "Sie schildern den Schaden, wir geben eine erste fachliche Einschätzung und vereinbaren einen kurzfristigen Termin." },
  { title: "Vor-Ort-Analyse & Leckortung", text: "Wir messen Feuchte und orten Leckagen möglichst zerstörungsfrei. Alles wird dokumentiert; die Abstimmung mit Ihrer Versicherung übernehmen wir gern." },
  { title: "Trocknung & Monitoring", text: "Wir installieren die passende Trocknungstechnik und kontrollieren den Verlauf regelmäßig. Am Ende erhalten Sie den Abschlussbericht." },
  { title: "Wiederherstellung", text: "Wir setzen betroffene Bereiche fachgerecht instand und koordinieren alle Gewerke – bis zur sauberen Übergabe." },
];

const stats = [
  { value: "98%", label: "Erfolgsquote bei Leckortung" },
  { value: "1 Tag", label: "bis zur Schadensaufnahme" },
  { value: "250+", label: "umgesetzte Projekte" },
  { value: "100%", label: "Zufriedenheit" },
];
---
<BaseLayout
  title="Wasserschadensanierung & Leckortung | Dein Trocknungsteam"
  description="Fachbetrieb für Wasserschadensanierung. Wir bieten Leckortung, Bautrocknung und Wiederherstellung aus einer Hand. Schnell vor Ort & inkl. Versicherungsservice!"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>Leckageortung und Bautrocknung – schnelle Hilfe bei Wasserschäden</h1>
        <p class="hero-subtitle">Professionelle Leckortung, Bautrocknung und Wasserschadensanierung. Schnell vor Ort, inklusive Versicherungsabwicklung.</p>
        <CallButton />
        <TrustBadges />
      </div>
    </div>
  </section>

  <section class="section" id="uber">
    <div class="container prose">
      <h2>Wir helfen!</h2>
      <p>Als erfahrenes Fachunternehmen für Bautrocknung und Wasserschadensanierung stehen wir seit Jahren für schnelle, präzise und nachhaltige Lösungen. Unser Fokus liegt dabei nicht nur auf der Trocknung – sondern vor allem auf der exakten Ursachenfindung. Denn nur wer die Ursache kennt, kann den Schaden dauerhaft beheben.</p>
      <p>Von unserem Standort in Neuss aus sind wir täglich im gesamten Rhein-Kreis Neuss und der Umgebung im Einsatz. Bei einem Wasserschaden zählt jede Stunde – je schneller die Ursache gefunden und die Trocknung gestartet wird, desto geringer bleiben Folgeschäden und Kosten.</p>
    </div>
  </section>

  <section class="section section-alt" id="leistungen">
    <div class="container">
      <h2 class="text-center">Unsere Leistungen, die sichtbare Erfolge liefern</h2>
      <ServicesGrid />
    </div>
  </section>

  <section class="section" id="ablauf">
    <div class="container">
      <h2>Der Ablauf beim Wasserschaden</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="step-num"></span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-alt" id="zahlen">
    <div class="container">
      <h2>Hinter jeder Zahl steckt Engagement, Qualität und sichtbarer Erfolg</h2>
      <div class="grid-3">
        {stats.map((s) => (
          <div class="card stat-card">
            <p class="stat-value">{s.value}</p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="referenzen">
    <div class="container">
      <h2 class="text-center">Erlebnisse, die überzeugen</h2>
      <div class="grid-3">
        <div class="card">
          <p>"Schnelle Reaktion, saubere Arbeit und sehr gute Kommunikation während des gesamten Einsatzes."</p>
          <p class="testimonial-author">Edgar Taach, Immonovesia GmbH</p>
        </div>
        <div class="card">
          <p>"Das Team hat die Leckage schnell und ohne unnötige Schäden lokalisiert und direkt die Trocknung eingeleitet."</p>
          <p class="testimonial-author">Matthias Commerscheidt, Eigentümer</p>
        </div>
        <div class="card">
          <p>"Besonders beeindruckt hat uns die strukturierte Vorgehensweise und die transparente Erklärung aller Schritte."</p>
          <p class="testimonial-author">Sonja Bursy, Hausverwaltung Nikolai GmbH</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding: 4rem 0 3rem;
      background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
      border-bottom: 1px solid var(--color-border);
    }
    .hero-subtitle {
      color: var(--color-ink-soft);
      font-size: 1.15rem;
      max-width: 55ch;
      margin-bottom: 1.5rem;
    }
    .steps {
      list-style: none;
      padding: 0;
      margin: 2rem 0 0;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .steps li {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      counter-increment: step;
    }
    .step-num {
      flex-shrink: 0;
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background: var(--color-primary);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: .9rem;
    }
    .step-num::before { content: counter(step); }
    .steps li h3 { margin: 0 0 .3rem; }
    .steps li p { margin: 0; color: var(--color-ink-soft); }
    .stat-card { text-align: left; }
    .stat-value {
      font-family: var(--font-display);
      font-size: 2.2rem;
      color: var(--color-accent);
      margin: 0;
    }
    .stat-label { color: var(--color-ink-soft); margin: .3rem 0 0; font-size: .9rem; }
    .testimonial-author {
      color: var(--color-ink-soft);
      font-size: .85rem;
      margin-top: 1rem;
      margin-bottom: 0;
    }
  </style>
</BaseLayout>
