---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallButton from '../components/CallButton.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import TrustBadges from '../components/TrustBadges.astro';

const steps = [
  { title: "Anruf & Ersteinschätzung", text: "Sie schildern den Schaden, wir geben eine erste fachliche Einschätzung und vereinbaren einen kurzfristigen Termin." },
  { title: "Vor-Ort-Analyse & Leckortung", text: "Wir messen Feuchte und orten Leckagen möglichst zerstörungsfrei. Alles wird dokumentiert; die Abstimmung mit Ihrer Versicherung übernehmen wir gern." },
  { title: "Trocknung & Monitoring", text: "Wir installieren die passende Trocknungstechnik und kontrollieren den Verlauf regelmäßig. Am Ende erhalten Sie den Abschlussbericht." },
  { title: "Sanierung", text: "Wir setzen betroffene Bereiche fachgerecht instand und koordinieren alle Gewerke – bis zur sauberen Übergabe." },
];

const stats = [
  { value: "10", label: "Jahre Erfahrung" },
  { value: "1 Tag", label: "bis zur Schadensaufnahme" },
  { value: "7 Tage", label: "die Woche erreichbar" },
  { value: "Fest", label: "ein Ansprechpartner pro Auftrag" },
];
---
<BaseLayout
  title="Leckortung & Bautrocknung in Neuss | Dein Trocknungsteam"
  description="Fachbetrieb für Wasserschadensanierung in Neuss. Wir bieten Leckortung, Bautrocknung und Sanierung aus einer Hand. Schnell vor Ort & inkl. Versicherungsservice!"
>
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <p class="eyebrow">Fachbetrieb in Neuss</p>
        <h1><span class="hero-line">Leckortung &amp; Bautrocknung in Neuss –</span><br class="desktop-break" /> <span class="hero-line">schnell zur Stelle bei Wasserschäden</span></h1>
        <p class="hero-subtitle">Professionelle Leckortung, Bautrocknung und Wasserschadensanierung im Rhein-Kreis Neuss. Schnell vor Ort, inklusive Versicherungsabwicklung.</p>
        <CallButton />
      </div>
    </div>
    <div class="container">
      <p class="trust-caption">Wir rechnen mit allen gängigen Versicherern ab, u.&nbsp;a.:</p>
      <TrustBadges />
    </div>
  </section>

  <section class="section" id="uber">
    <div class="container uber-grid">
      <div>
        <p class="eyebrow">Über uns</p>
        <h2>Wir helfen!</h2>
        <p>Als erfahrenes Fachunternehmen für Bautrocknung und Wasserschadensanierung stehen wir seit Jahren für schnelle, präzise und nachhaltige Lösungen. Unser Fokus liegt dabei nicht nur auf der Trocknung – sondern vor allem auf der exakten Ursachenfindung. Denn nur wer die Ursache kennt, kann den Schaden dauerhaft beheben.</p>
        <p>Von unserem Standort in Neuss aus sind wir täglich im gesamten Rhein-Kreis Neuss und der Umgebung im Einsatz. Bei einem Wasserschaden zählt jede Stunde – je schneller die Ursache gefunden und die Trocknung gestartet wird, desto geringer bleiben Folgeschäden und Kosten.</p>
      </div>
      <div class="uber-photo">
        <img src="/images/site/trocknungsgeraete-1.webp" alt="Trocknungsgeräte im Einsatz" title="Trocknungsgeräte im Einsatz" loading="lazy" />
        <p class="uber-quote">„Leckortung und Bautrocknung darf kein Glücksspiel sein“</p>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="leistungen">
    <div class="container">
      <h2 class="text-center">Unsere Leistungen, die sichtbare Erfolge liefern</h2>
      <ServicesGrid />
    </div>
  </section>

  <section class="section" id="ablauf">
    <div class="container ablauf-grid">
      <div class="ablauf-photo">
        <img src="/images/site/trocknungsgeraete-2.webp" alt="Trocknungsgeräte im Einsatz beim Wasserschaden" title="Trocknungsgeräte im Einsatz beim Wasserschaden" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Wie geht es weiter?</p>
        <h2>Der Ablauf beim Wasserschaden</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li>
              <span class="step-num"></span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="zahlen">
    <div class="container">
      <h2>Hinter jeder Zahl steckt Engagement, Qualität und sichtbarer Erfolg</h2>
      <div class="grid-3">
        {stats.map((s) => (
          <div class="card stat-card">
            <p class="stat-value">{s.value}</p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="referenzen">
    <div class="container">
      <h2 class="text-center">Erlebnisse, die überzeugen</h2>
      <p class="referenzen-rating text-center">★★★★★ 5,0 von 5 · echte Google-Bewertungen</p>
      <div class="grid-3">
        <div class="card">
          <p class="testimonial-stars">★★★★★</p>
          <p>"Wunderbare Zusammenarbeit und absolut empfehlenswert! Die Leckageortung wurde schnell und professionell durchgeführt. Super Service, unkomplizierte Kommunikation und eine wirklich reibungslose Abwicklung."</p>
          <p class="testimonial-author">Philip Mlitzko</p>
          <p class="testimonial-source">Google-Bewertung, September 2026</p>
        </div>
        <div class="card">
          <p class="testimonial-stars">★★★★★</p>
          <p>"Leckage in der Zwischendecke zwischen EG und Keller geortet und gefunden. Auch die Trocknung und Wiederherstellung im Nachgang hat reibungslos funktioniert. Absolute Empfehlung!"</p>
          <p class="testimonial-author">Matthias Commerscheidt</p>
          <p class="testimonial-source">Google-Bewertung, Mai 2026</p>
        </div>
        <div class="card">
          <p class="testimonial-stars">★★★★★</p>
          <p>"Top Beratung, immer wieder gerne. Absolut zu empfehlen!"</p>
          <p class="testimonial-author">Lennard Ratzer</p>
          <p class="testimonial-source">Google-Bewertung, September 2025</p>
        </div>
      </div>
      <p class="referenzen-link text-center"><a href="https://www.google.com/maps/place/Dein+Trocknungsteam+-+Leckortung+und+Bautrocknung/@51.1349088,6.7473374,17z/data=!4m8!3m7!1s0x47bf3545becc067d:0x8112ae3131fe52f3!8m2!3d51.1349088!4d6.7499123!9m1!1b1!16s%2Fg%2F11vql_zwx4" target="_blank" rel="noopener">Alle Bewertungen bei Google ansehen</a></p>
    </div>
  </section>

<style>
.hero {
  padding: 4rem 0 3rem;
  background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
  border-bottom: 1px solid var(--color-border);
}
.hero-inner { max-width: 62ch; }
.hero-line { white-space: nowrap; }
@media (max-width: 800px) {
  .desktop-break { display: none; }
  .hero-line { white-space: normal; }
}
.hero-subtitle {
  color: var(--color-ink-soft);
  font-size: 1.15rem;
  margin-bottom: 1.75rem;
}
.trust-caption {
  font-size: .85rem;
  color: var(--color-ink-soft);
  text-align: center;
  margin: 0 0 .5rem;
}
.uber-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}
.uber-photo {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  min-height: 420px;
}
.uber-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}
.uber-photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(rgba(255,255,255,0) 0%, rgba(0,0,0,.85) 100%);
}
.uber-quote {
  position: absolute;
  left: 1.5rem;
  right: 1.5rem;
  bottom: 1.5rem;
  z-index: 1;
  color: white;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.3rem;
  margin: 0;
}
.ablauf-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 3rem;
  align-items: start;
}
.ablauf-photo {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  min-height: 420px;
}
.ablauf-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}
@media (max-width: 800px) {
  .uber-grid { grid-template-columns: 1fr; }
  .ablauf-grid { grid-template-columns: 1fr; }
}
.steps {
  list-style: none;
  padding: 0;
  margin: 2rem 0 0;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.steps li {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  counter-increment: step;
}
.step-num {
  flex-shrink: 0;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background: var(--color-accent-dark);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: .9rem;
}
.step-num::before { content: counter(step); }
.steps li h3 { margin: 0 0 .3rem; }
.steps li p { margin: 0; color: var(--color-ink-soft); }
.stat-card { text-align: left; }
.stat-value {
  font-family: var(--font-display);
  font-size: 2.2rem;
  color: var(--color-accent-dark);
  margin: 0;
}
.stat-label { color: var(--color-ink-soft); font-family: var(--font-body); margin: .3rem 0 0; font-size: .9rem; }
.testimonial-author {
  color: var(--color-ink-soft);
  font-family: var(--font-body);
  font-size: .85rem;
  margin-top: 1rem;
  margin-bottom: 0;
}
.testimonial-stars {
  color: #F5A623;
  letter-spacing: .1rem;
  margin: 0 0 .6rem;
  font-size: .95rem;
}
.testimonial-source {
  color: var(--color-ink-soft);
  font-family: var(--font-body);
  font-size: .78rem;
  margin: .15rem 0 0;
}
.referenzen-rating {
  color: var(--color-ink-soft);
  font-size: .95rem;
  margin: -.5rem 0 2rem;
}
.referenzen-link { margin: 2rem 0 0; }
.referenzen-link a { color: var(--color-accent); font-weight: 600; text-decoration: none; }
.referenzen-link a:hover { text-decoration: underline; }
#referenzen .card p { font-family: var(--font-body); }
</style>
</BaseLayout>
