---
import { getEntry, getCollection } from 'astro:content';
import ServiceLayout from '../layouts/ServiceLayout.astro';

const entry = await getEntry('services', 'wiederherstellung');
const { Content: Body } = await entry.render();

const cityEntries = await getCollection('cities');
const cities = cityEntries
  .map((c) => ({ name: c.data.name, slug: c.slug }))
  .sort((a, b) => a.name.localeCompare(b.name, 'de'));

const relatedPosts = [
  { slug: "wasserschaden-sanierung-aus-einer-hand-vom-leck-bis-zum-neuen-anstrich", title: "Wasserschadensanierung aus einer Hand", excerpt: "Leckortung, Trocknung, Malerarbeiten – wie eine Komplettsanierung Zeit, Nerven und Kosten spart." },
  { slug: "wer-zahlt-die-sanierung-nach-einem-wasserschaden", title: "Sanierung nach Wasserschaden: Wer zahlt?", excerpt: "Estrich, Putz, Tapeten, Bodenbeläge: Wer übernimmt die Kosten der Sanierung?" },
  { slug: "gebaeudeversicherung-bei-wasserschaden-wer-zahlt-was", title: "Gebäudeversicherung bei Wasserschaden", excerpt: "Was deckt die Gebäudeversicherung ab, was nicht? Leistungsumfang und typische Ausschlüsse." },
];
---
<ServiceLayout
  title={entry.data.title}
  heroSubtitle={entry.data.heroSubtitle}
  metaDescription={entry.data.metaDescription}
  heroImage={entry.data.heroImage}
  techniquesHeading={entry.data.techniquesHeading}
  techniquesImage={entry.data.techniquesImage}
  techniques={entry.data.techniques}
  cities={cities}
  relatedPosts={relatedPosts}
  serviceType="Wasserschadensanierung"
  citiesHeading="Sanierung nach Wasserschäden in Ihrer Region"
  citiesIntro="Wir sind rund um Neuss und Grevenbroich ebenso im Einsatz wie im gesamten Rhein-Kreis Neuss, in Düsseldorf, Köln und den umliegenden Kreisen Mettmann und Heinsberg. Direkt zu Ihrer Stadt:"
>
  <Body />
</ServiceLayout>
