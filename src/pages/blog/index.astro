---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
title="Ratgeber Trocknung & Wasserschaden | Dein Trocknungsteam"
description="Erfahren Sie alles über professionelle Trocknung, Leckortung und Sanierung. Experten-Tipps für Hausbesitzer und Bauherren in unserem Blog."
>
<section class="section">
<div class="container">
<h1>Ratgeber & News rund um die Trocknung und Sanierung</h1>
<p class="prose">In unserem Magazin finden Sie Experten-Tipps zur Trocknung, Leckortung und Schimmelvermeidung.</p>
<p class="prose">
  Von den ersten Anzeichen eines Wasserschadens über die richtige Vorgehensweise bei der Trocknung bis hin zu
  Fragen rund um Versicherung und Kostenübernahme: Wir teilen hier unser Praxiswissen aus über 10 Jahren
  Erfahrung im Rhein-Kreis Neuss – verständlich erklärt und ohne Fachjargon, damit Sie im Ernstfall schnell
  die richtigen Entscheidungen treffen können.
</p>
<div class="grid-3 post-grid">
{posts.map((post) => (
<a href={`/${post.slug}/`} class="card post-card">
{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} title={post.data.title} class="post-thumb" loading="lazy" />}
<h3>{post.data.title}</h3>
<p>{post.data.metaDescription}</p>
</a>
))}
</div>
</div>
</section>
<style>
.post-grid { margin-top: 2rem; }
.post-card { text-decoration: none; color: inherit; border-top: 3px solid var(--color-accent); }
.post-card p { color: var(--color-ink-soft); font-size: .92rem; }
.post-thumb {
width: 100%;
height: 170px;
object-fit: cover;
border-radius: var(--radius-sm);
margin-bottom: 1rem;
display: block;
}
</style>
</BaseLayout>
