# Redirects for retired WordPress pages after Astro migration

RewriteEngine On

# Duplicate/old slug -> current service page
RewriteRule ^sanierung/?$ /wiederherstellung/ [R=301,L]

# Deferred content gap -> homepage for now (page to be rebuilt later)
RewriteRule ^abdichtung/?$ / [R=301,L]

# Missing blog article -> blog overview
RewriteRule ^leckortung-ohne-stemmarbeiten-so-finden-wir-den-schaden-unsichtbar/?$ /blog/ [R=301,L]

# WordPress tag/topic archive pages -> blog overview
RewriteRule ^thema/.*$ /blog/ [R=301,L]
RewriteRule ^themen/?$ /blog/ [R=301,L]

# Safety net for old Kreis Düren slug variant
RewriteRule ^kreis-dueren/?$ /dueren/ [R=301,L]

# --- Browser caching for static assets (PageSpeed: "Effiziente Verweildauer im Cache") ---
# Astro fingerprints its own build output (/_astro/*), so those files never change
# under the same filename and can be cached "forever". Images, fonts and icons are
# cached for a shorter but still long period, in case a file is replaced under the
# same name (e.g. a re-exported logo.webp).
<IfModule mod_expires.c>
  ExpiresActive On

  # Astro's hashed build assets (CSS/JS) – safe to cache for a very long time
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted Astro build assets: filename changes whenever the content does,
  # so these can be marked immutable.
  <FilesMatch "^_astro/.*\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
